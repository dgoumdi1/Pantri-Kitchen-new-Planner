# Copy this file to .env and replace the placeholders with local values.
# PORT is set separately for each server: 19987 for the frontend, 5000 for the API.

DATABASE_URL=postgresql://postgres:password@localhost:5432/pantri

# Clerk keys are required for sign-in.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Optional: enables the Gemini assistant features.
GEMINI_API_KEY=

# Required by the Vite config; keep / for local development.
BASE_PATH=/

# Set only when using the production Clerk proxy; leave blank for local development.
VITE_CLERK_PROXY_URL=